# Required: create a Feishu app and an OpenAI API key.
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=replace_me
OPENAI_API_KEY=replace_me

# Optional runtime settings.
MAXREAD_OPENAI_MODEL=gpt-5.5
MAXREAD_OPENAI_REASONING_EFFORT=high
MAXREAD_OPENAI_TIMEOUT_SECONDS=300
MAXREAD_MAX_CONTEXT_CHARS=600000
MAXREAD_MAX_FILE_CHARS=200000
MAXREAD_MAX_CONTEXT_FILES=200
MAXREAD_MAX_QUEUED_JOBS=500
MAXREAD_DATA_DIR=./reader/data
FEISHU_API_TIMEOUT_SECONDS=30
# Empty means console-only logging. Set an explicit protected path to persist logs.
MAXREAD_LOG_FILE=

# Disabled by default. Even when enabled, only status/timestamp/model are kept.
MAXREAD_ENABLE_COMMENT_AUDIT_LOG=false
